rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    function isSignedIn() {
      return request.auth != null;
    }
    function isSelf(uid) {
      return isSignedIn() && request.auth.uid == uid;
    }

    // Public profiles: anyone signed in can read (friend search); only the owner writes.
    match /users/{uid} {
      allow read: if isSignedIn();
      allow create: if isSelf(uid);
      allow update: if isSelf(uid);
      allow delete: if false;

      // Match history is private to the owner, and written only by the server
      // when it finalizes a game (see functions/src/recordResults.ts).
      match /matchHistory/{entryId} {
        allow read: if isSelf(uid);
        allow write: if false;
      }
    }

    // Friendships: one shared edge doc per pair, keyed by the sorted uids.
    //
    // A member may read and delete their own edges. Creating one requires that
    // the OTHER member actually sent you a request — i.e. you're accepting, not
    // force-friending yourself into a stranger's graph (the hole the old
    // `friends/{friendUid}` rule left open). Edges are immutable once written.
    match /friendships/{pairId} {
      function otherMember() {
        return request.resource.data.users[0] == request.auth.uid
          ? request.resource.data.users[1]
          : request.resource.data.users[0];
      }
      // `get` allows an existence check on a doc that isn't there yet — sendRequest
      // reads this pair before writing. A rule that dereferences resource.data
      // DENIES a get on a missing doc, so guard with `resource == null`.
      allow get: if isSignedIn()
        && (resource == null || request.auth.uid in resource.data.users);
      // `list` backs the array-contains friends query; matched docs always exist.
      allow list: if isSignedIn() && request.auth.uid in resource.data.users;
      allow create: if isSignedIn()
        && request.resource.data.users.size() == 2
        && request.auth.uid in request.resource.data.users
        && exists(/databases/$(database)/documents/friendRequests/$(otherMember() + '_' + request.auth.uid));
      // Deleting a missing edge is a harmless no-op; allow it (resource == null) so
      // an unfriend that races the listener doesn't throw a permissions error.
      allow delete: if isSignedIn()
        && (resource == null || request.auth.uid in resource.data.users);
      allow update: if false;
    }

    // Statistics: world-readable for leaderboards, written only by the server.
    //
    // This was `allow write: if isSelf(uid)`, which made the leaderboard free
    // money — anyone could write themselves nine thousand wins without playing a
    // single game. Cheat-proof moves are worth very little next to a forgeable
    // win record, so the result is now recorded by the Cloud Function that
    // finalizes the match (see functions/src/recordResults.ts).
    //
    // The one thing a client may still do is open its *own* row on sign-up, and
    // only at zero. `create` cannot touch a row that already exists, and update
    // and delete are closed, so there is no path from here to a record you did
    // not play for.
    match /statistics/{uid} {
      allow read: if isSignedIn();
      allow create: if isSelf(uid)
        && request.resource.data.keys().hasOnly(
             ['uid', 'gamesPlayed', 'wins', 'losses', 'draws',
              'totalBoxesWon', 'winStreak', 'bestWinStreak'])
        && request.resource.data.uid == uid
        && request.resource.data.gamesPlayed == 0
        && request.resource.data.wins == 0
        && request.resource.data.losses == 0
        && request.resource.data.draws == 0
        && request.resource.data.totalBoxesWon == 0
        && request.resource.data.winStreak == 0
        && request.resource.data.bestWinStreak == 0;
      allow update, delete: if false;
    }

    // Settings are private to the owner.
    match /settings/{uid} {
      allow read, write: if isSelf(uid);
    }

    // Friend requests: visible to sender and recipient; the recipient resolves them.
    match /friendRequests/{requestId} {
      // `get` allows sender and recipient to read one request — and to check a
      // request that doesn't exist yet (sendRequest probes the reverse/forward
      // ids before writing), which a resource.data rule would otherwise deny.
      allow get: if isSignedIn()
        && (resource == null
            || resource.data.fromUid == request.auth.uid
            || resource.data.toUid == request.auth.uid);
      // `list` backs only the recipient's incoming-requests query.
      allow list: if isSignedIn() && resource.data.toUid == request.auth.uid;
      // The sender creates it, and it may not be a request to yourself.
      allow create: if isSignedIn()
        && request.resource.data.fromUid == request.auth.uid
        && request.resource.data.toUid != request.auth.uid;
      // Sender or recipient may delete. `resource == null` matters because
      // acceptRequest deletes BOTH the request and its (usually non-existent)
      // reverse in one atomic batch — without this, deleting the missing reverse
      // is denied and the whole accept (friendship create included) is rejected.
      allow delete: if isSignedIn() &&
        (resource == null
         || resource.data.fromUid == request.auth.uid
         || resource.data.toUid == request.auth.uid);
      allow update: if false;
    }

    match /leaderboard/{entryId} {
      allow read: if isSignedIn();
      allow write: if false; // maintained server-side only
    }
  }
}
