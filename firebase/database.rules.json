{
  "rules": {
    ".read": false,
    ".write": false,

    "gameMembers": {
      "$gameId": {
        ".read": "auth != null",
        ".write": "auth != null && (!data.exists() || data.child(auth.uid).exists())"
      }
    },

    "games": {
      "$gameId": {
        ".read": "auth != null",

        ".write": "auth != null && !data.exists() && newData.exists() && root.child('gameMembers').child($gameId).child(auth.uid).exists()",

        ".validate": "newData.hasChildren(['id', 'board', 'players', 'turnOrder', 'currentTurn']) && newData.child('phase').val() === 'playing' && newData.child('version').val() === 0 && !newData.child('result').exists() && !newData.child('board/lines').exists() && !newData.child('board/boxes').exists()",

        "players": {
          "$playerId": {
            "score": { ".validate": "newData.val() === 0" },
            "consecutiveMisses": { ".validate": "newData.val() === 0" },
            "isEliminated": { ".validate": "newData.val() === false" }
          }
        }
      }
    },

    "activeGames": {
      ".indexOn": ".value",
      "$gameId": {
        ".write": "auth != null && !data.exists() && root.child('gameMembers').child($gameId).child(auth.uid).exists()",
        ".validate": "newData.isNumber()"
      }
    },

    "gamePresence": {
      "$gameId": {
        ".read": "auth != null",
        "$playerId": {
          ".write": "auth != null && root.child('games').child($gameId).child('players').child($playerId).child('uid').val() === auth.uid",
          "isConnected": {
            ".validate": "newData.isBoolean()"
          },
          "disconnectedAt": {
            ".validate": "newData.isNumber()"
          },
          "lastSeenAt": {
            ".validate": "newData.isNumber()"
          }
        }
      }
    },

    "rooms": {
      "$roomId": {
        ".read": "auth != null",
        ".write": "auth != null && (!data.exists() || data.child('members').child(auth.uid).exists() || newData.child('members').child(auth.uid).exists() || data.child('hostUid').val() == auth.uid)"
      }
    },

    "roomCodes": {
      ".read": "auth != null",
      "$code": {
        ".write": "auth != null"
      }
    },

    "matchmaking": {
      "queue": {
        ".read": "auth != null",
        "$uid": {
          ".write": "auth != null && (auth.uid == $uid || (data.exists() && !data.child('gameId').exists() && newData.child('gameId').isString()))"
        }
      }
    },

    "presence": {
      "$uid": {
        ".read": "auth != null",
        ".write": "auth != null && auth.uid == $uid"
      }
    }
  }
}
