{
  "rules": {
    ".read": false,
    ".write": false,

    "games": {
      "$gameId": {
        ".read": "auth != null",
        ".write": false
      }
    },

    "gameMembers": {
      "$gameId": {
        ".read": "auth != null",
        ".write": false
      }
    },

    "activeGames": {
      ".indexOn": ".value"
    },

    "pendingResults": {
      ".indexOn": ".value"
    },

    "finishedGames": {
      ".indexOn": ".value"
    },

    "gamePresence": {
      "$gameId": {
        ".read": "auth != null",
        "$playerId": {
          ".write": "auth != null && root.child('games').child($gameId).child('players').child($playerId).child('uid').val() === auth.uid",
          "isConnected": { ".validate": "newData.isBoolean()" },
          "disconnectedAt": { ".validate": "newData.isNumber()" },
          "lastSeenAt": { ".validate": "newData.isNumber()" }
        }
      }
    },

    "rooms": {
      "$roomId": {
        ".read": "auth != null",
        ".write": "auth != null && (!data.exists() || data.child('members').child(auth.uid).exists() || newData.child('members').child(auth.uid).exists() || data.child('hostUid').val() == auth.uid)",

        "hostUid": {
          ".validate": "!data.exists() || data.val() === auth.uid"
        },
        "gameId": {
          ".validate": false
        },
        "status": {
          ".validate": "newData.val() === 'open' || newData.val() === 'starting' || newData.val() === 'closed'"
        }
      }
    },

    "roomCodes": {
      ".read": "auth != null",
      "$code": {
        ".write": "auth != null"
      }
    },

    "matchmaking": {
      "queue": {
        ".read": "auth != null",
        "$uid": {
          ".write": "auth != null && (auth.uid == $uid || (data.exists() && !data.child('claimedBy').exists() && newData.child('claimedBy').val() == auth.uid))",

          "gameId": {
            ".validate": false
          },
          "claimedBy": {
            ".validate": "newData.isString()"
          }
        }
      }
    },

    "presence": {
      "$uid": {
        ".read": "auth != null",
        ".write": "auth != null && auth.uid == $uid"
      }
    }
  }
}
