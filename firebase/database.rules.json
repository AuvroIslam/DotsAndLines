{
  "rules": {
    ".read": false,
    ".write": false,

    "gameMembers": {
      "$gameId": {
        ".read": "auth != null",
        ".write": "auth != null && (!data.exists() || data.child(auth.uid).exists())"
      }
    },

    "games": {
      "$gameId": {
        ".read": "auth != null",
        ".write": "auth != null && root.child('gameMembers').child($gameId).child(auth.uid).exists()",

        "phase": {
          ".validate": "newData.val() === 'waiting' || newData.val() === 'playing'"
        },
        "result": {
          ".validate": false
        },

        "players": {
          "$playerId": {
            "isEliminated": {
              ".validate": "newData.isBoolean() && (newData.val() === false || newData.val() === data.val())"
            },
            "consecutiveMisses": {
              ".validate": "newData.isNumber() && (newData.val() === 0 || newData.val() === data.val())"
            }
          }
        },
        ".validate": "newData.hasChildren(['id', 'board', 'players', 'turnOrder', 'currentTurn'])"
      }
    },

    "activeGames": {
      ".indexOn": ".value",
      "$gameId": {
        ".write": "auth != null && root.child('gameMembers').child($gameId).child(auth.uid).exists()",
        ".validate": "newData.isNumber()"
      }
    },

    "gamePresence": {
      "$gameId": {
        ".read": "auth != null",
        "$playerId": {
          ".write": "auth != null && root.child('games').child($gameId).child('players').child($playerId).child('uid').val() === auth.uid",
          "isConnected": {
            ".validate": "newData.isBoolean()"
          },
          "disconnectedAt": {
            ".validate": "newData.isNumber()"
          },
          "lastSeenAt": {
            ".validate": "newData.isNumber()"
          }
        }
      }
    },

    "rooms": {
      "$roomId": {
        ".read": "auth != null",
        ".write": "auth != null && (!data.exists() || data.child('members').child(auth.uid).exists() || newData.child('members').child(auth.uid).exists() || data.child('hostUid').val() == auth.uid)"
      }
    },

    "roomCodes": {
      ".read": "auth != null",
      "$code": {
        ".write": "auth != null"
      }
    },

    "matchmaking": {
      "queue": {
        ".read": "auth != null",
        "$uid": {
          ".write": "auth != null && (auth.uid == $uid || (data.exists() && !data.child('gameId').exists() && newData.child('gameId').isString()))"
        }
      }
    },

    "presence": {
      "$uid": {
        ".read": "auth != null",
        ".write": "auth != null && auth.uid == $uid"
      }
    }
  }
}
